# Maintainer: mikedigriz <mikedigriz@users.noreply.github.com>
#
# pkgver and sha256sums are rewritten by .github/workflows/release.yml at tag
# time, and the resulting PKGBUILD is attached to the release. The copy in the
# repository tracks the latest published tag so that `makepkg -si` works
# straight from a clone; grab the one off the release page if you want the
# checksum filled in.
pkgname=chrome-glass-remastered-cursors
pkgver=1.0.5
pkgrel=1
pkgdesc="Chrome Glass (2006) cursor remaster: original pixels, crisp 32-512px, vector edges"
arch=('any')
url="https://github.com/mikedigriz/chrome-glass-remastered-cursors"
license=('custom:MIT')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/ChromeGlassRemastered-linux.tar.gz")
sha256sums=('SKIP')

package() {
    local theme="Chrome Glass Remastered"

    install -dm755 "$pkgdir/usr/share/icons"
    cp -r "$srcdir/$theme" "$pkgdir/usr/share/icons/"
    find "$pkgdir/usr/share/icons" -type f -exec chmod 644 {} +

    # LICENSE and NOTICE ride along inside the theme folder so the attribution
    # survives a manual unpack; a package puts them where Arch expects instead.
    install -Dm644 "$srcdir/$theme/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/$theme/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    rm -f "$pkgdir/usr/share/icons/$theme/LICENSE" "$pkgdir/usr/share/icons/$theme/NOTICE"
}
