# Default for everything git detects as text. Without it, whether a file is
# stored with LF or CRLF depends on the core.autocrlf of whoever added it, and
# LICENSE, NOTICE and the requirements files ended up with CRLF that way - they
# then read as modified on any machine configured differently. Later rules below
# override this one; in gitattributes the last match wins.
* text=auto eol=lf
# Keep shell scripts LF so they run on Linux even when cloned on Windows.
*.sh            text eol=lf
*.py            text eol=lf
# Extensionless, so it would otherwise inherit the platform default: cloned on
# Windows with core.autocrlf=true it gets CRLF and makepkg chokes on package().
PKGBUILD        text eol=lf
# Windows INF expects CRLF.
*.inf           text eol=crlf
# Binary assets - never touch line endings.
*.png           binary
*.webp          binary
*.gif           binary
*.cur           binary
*.ani           binary
*.deb           binary
# Generated, not written by hand - keep it out of GitHub's language stats and
# collapsed in diffs.
data/traced.json linguist-generated=true
art/ai/**       linguist-generated=true
art/ai512/**    linguist-generated=true
art/aialpha/**  linguist-generated=true
